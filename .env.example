# Copie para .env.local. Nunca commite .env*.
# Tudo aqui é público (vai embutido no site estático). Chaves secretas ficam só nas
# Edge Functions do Supabase (`supabase secrets set`), nunca neste arquivo.
# Valores locais: `npx supabase status -o env` (API_URL e PUBLISHABLE_KEY).

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
